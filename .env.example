# DVLA Vehicle Enquiry Service (separate from DVSA MOT History)
# Needed for live DVLA vehicle/tax data.
DVLA_API_KEY=

# DVSA MOT History API
DVSA_API_KEY=
DVSA_CLIENT_ID=
DVSA_CLIENT_SECRET=
DVSA_TOKEN_URL=https://login.microsoftonline.com/YOUR_TENANT_ID/oauth2/v2.0/token
DVSA_SCOPE=https://tapi.dvsa.gov.uk/.default

PORT=8080

# eBay Browse API (live comparable-listing valuation)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Marketplace Account Deletion webhook. Use the exact same HTTPS endpoint and
# verification token in eBay Developer Notifications. Token: 32-80 chars,
# letters/numbers/underscore/hyphen only.
EBAY_NOTIFICATION_ENDPOINT=https://YOUR-DOMAIN/api/ebay/account-deletion
EBAY_NOTIFICATION_TOKEN=

# Google OAuth web client for optional Drive App Data sync
GOOGLE_CLIENT_ID=

# Cloudflare scheduled notification relay (Email + Web Push)
# See cloudflare/notification-relay/README.md
NOTIFICATION_RELAY_URL=
NOTIFICATION_RELAY_SECRET=

# Original Car Search Hub (Python/Playwright), embedded within the DriveHub container.
# REQUIRED in production; log in to Car Search with this password.
CAR_SEARCH_PASSWORD=
# Optional: stable signing key to retain Car Search login sessions across deploys.
CAR_SEARCH_SESSION_SECRET=
# Optional: Google sign-in for Car Search. Each person signs in with their own
# Google account and their searches, listings and notes are kept in that
# account's Google Drive (private app data), not on this server. Uses
# GOOGLE_CLIENT_ID above. When on, CAR_SEARCH_PASSWORD is no longer used.
# CAR_SEARCH_GOOGLE_LOGIN=on
# Comma-separated Google accounts allowed to sign in (required when on).
# CAR_SEARCH_ALLOWED_EMAILS=you@gmail.com,partner@gmail.com
# Optional: this account's first sign-in copies the existing shared data
# (/data/car-search-hub.json) into their Google Drive. The file is left in place.
# CAR_SEARCH_OWNER_EMAIL=you@gmail.com
# Optional eBay Browse API for high-quality listing results (uses same values as Valuation).
# EBAY_CLIENT_ID=  EBAY_CLIENT_SECRET=
# Optional Facebook Marketplace account: set credentials or use the in-app session manager.
FACEBOOK_EMAIL=
FACEBOOK_PASSWORD=
# Persistent Car Search data: /data/car-search-hub.json, alongside DriveHub's data.
# CAR_SEARCH_DATA_DIR=/data
